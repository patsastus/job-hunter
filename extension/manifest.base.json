{
  "manifest_version": 3,
  "name": "Job Hunter",
  "version": "0.3.0",
  "description": "Scores job ads as you read them against your own profile, and keeps the ones that matter in your local Job Hunter.",
  "permissions": ["storage", "activeTab", "alarms", "scripting"],
  "host_permissions": ["http://jobs.test/*"],
  "content_scripts": [
    {
      "matches": ["*://duunitori.fi/tyopaikat/tyo/*", "*://www.duunitori.fi/tyopaikat/tyo/*"],
      "js": ["parsers/jsonld.js", "parsers/duunitori.js", "content/duunitori.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Job Hunter",
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "save-job": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save this job"
    },
    "reject-job": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Reject this job"
    }
  }
}
