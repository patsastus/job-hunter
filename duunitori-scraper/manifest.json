{
  "manifest_version": 3,
  "name": "Job Scraper (Duunitori & LinkedIn)",
  "version": "1.1",
  "description": "Scrape job details from Duunitori and LinkedIn, save as Markdown",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://duunitori.fi/*",
    "*://*.linkedin.com/jobs/*",
    "*://jobs.test/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "job-scraper@nraatika.local",
      "strict_min_version": "128.0"
    }
  }
}
